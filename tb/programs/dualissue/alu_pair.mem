// E2 Program 1 - Two independent ALU operations issued together
// No pair has a dependency inside it, so every pair issues in one cycle (both ALUs busy).
// Expected: x5=10 x6=6 x7=7 x8=2 x9=12 x10=1 ; MEM[0]=10 [4]=6 [8]=12
00300093  //   0: addi x1, x0, 3         ; pair: ALU + ALU
00700113  //   4: addi x2, x0, 7
00A00193  //   8: addi x3, x0, 10        ; pair: ALU + ALU
00400213  //  12: addi x4, x0, 4
002082B3  //  16: add  x5, x1, x2        ; pair: 3+7 = 10
40418333  //  20: sub  x6, x3, x4        ; 10-4 = 6
0040E3B3  //  24: or   x7, x1, x4        ; pair: 3|4 = 7
00317433  //  28: and  x8, x2, x3        ; 7&10 = 2
0062C4B3  //  32: xor  x9, x5, x6        ; pair: 10^6 = 12
00322533  //  36: slt  x10, x4, x3       ; 4<10 = 1
00502023  //  40: sw   x5, 0(x0)         ; pair: MEM + ALU
00100593  //  44: addi x11, x0, 1
00602223  //  48: sw   x6, 4(x0)         ; pair: MEM + ALU
00200613  //  52: addi x12, x0, 2
00902423  //  56: sw   x9, 8(x0)
0000006F  //  60: jal  x0, halt
