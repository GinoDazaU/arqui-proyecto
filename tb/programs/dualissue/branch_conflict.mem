// E2 Program 7 - Single branch unit: two control instructions in the same pair, jal in slot 1
// - beq + beq and beq + jal in the same pair -> structural conflict on the branch unit,
//   issued in different cycles (the younger one is regrouped as the next slot 0)
// - jal in slot 1 taken -> slot 0 (older) is kept, younger instructions are flushed
// - branch in slot 1 that depends on slot 0 (RAW) -> issued alone in the next cycle
// Wrong-path instructions write x3; they must never retire.
// Expected: x3=3 x4=1 x5=40 x7=7 x8=8 ; MEM[0]=3 [4]=1 [8]=40 [12]=7 [16]=8
00500093  //   0:       addi x1, x0, 5          ; pair
00500113  //   4:       addi x2, x0, 5
00300193  //   8:       addi x3, x0, 3          ; pair
00800413  //  12:       addi x8, x0, 8
04008663  //  16:       beq  x1, x0, bad        ; pair: TWO branches -> single branch unit: only slot 0 issues; NOT taken
00208663  //  20:       beq  x1, x2, t1         ; waits, regrouped as slot 0 in the next cycle; TAKEN
06300193  //  24:       addi x3, x0, 99         ; wrong path
06300193  //  28:       addi x3, x0, 99         ; wrong path
00100213  //  32: t1:   addi x4, x0, 1          ; pair: jal in slot 1 TAKEN -> slot 0 (older) is kept
00C002EF  //  36:       jal  x5, t2             ; x5 = return address
06300193  //  40:       addi x3, x0, 99         ; wrong path
06300193  //  44:       addi x3, x0, 99         ; wrong path
00208663  //  48: t2:   beq  x1, x2, t3         ; pair: beq + jal -> only the beq issues; beq TAKEN
028001EF  //  52:       jal  x3, bad            ; wrong path: waits in Decode and is flushed (would write x3)
06300193  //  56:       addi x3, x0, 99         ; wrong path
00700393  //  60: t3:   addi x7, x0, 7          ; pair: branch in slot 1 needs x7 (RAW) -> waits, regrouped
00038E63  //  64:       beq  x7, x0, bad        ; NOT taken (x7 forwarded)
00302023  //  68:       sw   x3, 0(x0)
00402223  //  72:       sw   x4, 4(x0)
00502423  //  76:       sw   x5, 8(x0)
00702623  //  80:       sw   x7, 12(x0)
00802823  //  84:       sw   x8, 16(x0)
0000006F  //  88: halt: jal  x0, halt
06300193  //  92: bad:  addi x3, x0, 99         ; only reached on a wrong branch
FF9FF06F  //  96:       jal  x0, halt
