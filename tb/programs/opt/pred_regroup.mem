// target (addi x10). The beq is correctly predicted, so that instruction must not be annulled.
// Expected: x1=6 x10=30 x5=9 ; MEM[0]=30 [4]=9
00000093  //   0: addi x1, x0, 0
00600113  //   4: addi x2, x0, 6
00100193  //   8: addi x3, x0, 1
00000513  //  12: addi x10, x0, 0
00550513  //  16: addi x10, x10, 5       ; loop: joins the beq after the regroup
00108093  //  20: addi x1, x1, 1
0020A233  //  24: slt  x4, x1, x2
FE320AE3  //  28: beq  x4, x3, loop      ; RAW on x4 -> regroup
00900293  //  32: addi x5, x0, 9
00A02023  //  36: sw   x10, 0(x0)
00502223  //  40: sw   x5, 4(x0)
0000006F  //  44: jal  x0, 0
