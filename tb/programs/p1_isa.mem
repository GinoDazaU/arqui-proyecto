// Program 1 - ISA without dependencies that need the Hazard Unit
// Producers are 3+ instructions away from consumers, so no forwarding/stall/flush.
// Expected stores: MEM[0]=17 [4]=7 [8]=4 [12]=13 [16]=9 [20]=1 [24]=15 [28]=4 [32]=13 [36]=1 [40]=3 [44]=17
00C00093  //   0: addi x1, x0, 12    ; x1 = 12
00500113  //   4: addi x2, x0, 5     ; x2 = 5
00000013  //   8: nop
00000013  //  12: nop
002081B3  //  16: add  x3, x1, x2    ; 17
40208233  //  20: sub  x4, x1, x2    ; 7
0020F2B3  //  24: and  x5, x1, x2    ; 4
0020E333  //  28: or   x6, x1, x2    ; 13
0020C3B3  //  32: xor  x7, x1, x2    ; 9
00112433  //  36: slt  x8, x2, x1    ; 1 (5 < 12)
00308493  //  40: addi x9, x1, 3     ; 15
0060F513  //  44: andi x10, x1, 6    ; 4
00816593  //  48: ori  x11, x2, 8    ; 13
00612613  //  52: slti x12, x2, 6    ; 1
00F0C693  //  56: xori x13, x1, 15   ; 3
00302023  //  60: sw   x3, 0(x0)
00402223  //  64: sw   x4, 4(x0)
00502423  //  68: sw   x5, 8(x0)
00602623  //  72: sw   x6, 12(x0)
00702823  //  76: sw   x7, 16(x0)
00802A23  //  80: sw   x8, 20(x0)
00902C23  //  84: sw   x9, 24(x0)
00A02E23  //  88: sw   x10, 28(x0)
02B02023  //  92: sw   x11, 32(x0)
02C02223  //  96: sw   x12, 36(x0)
02D02423  // 100: sw   x13, 40(x0)
00002703  // 104: lw   x14, 0(x0)    ; reload 17
00000013  // 108: nop
00000013  // 112: nop
02E02623  // 116: sw   x14, 44(x0)
0000006F  // 120: jal  x0, 0         ; end: loop forever
